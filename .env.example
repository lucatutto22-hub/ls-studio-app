# Adresse publique de l'application (liens dans les e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase : Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète : serveur uniquement, ne jamais la partager
SUPABASE_SECRET_KEY=sb_secret_xxx

# Cloudflare R2 : stockage des photos et vidéos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ls-studio-fichiers

# Resend : e-mails de notification (facultatif, rien n'est envoyé si vide)
RESEND_API_KEY=
MAIL_FROM="LS Studio <notifications@votre-domaine.fr>"
